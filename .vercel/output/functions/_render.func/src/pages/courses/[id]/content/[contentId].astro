---
import Layout from '../../../../layouts/Layout.astro';
import { db } from '../../../../lib/db';
import { verifyToken } from '../../../../lib/auth';
import type { Row } from '@libsql/client';

interface Student {
  id: number;
  first_name: string;
  last_name: string;
}

interface Attendance {
  student_id: number;
  status: 'completed' | 'pending' | 'missed';
}

// Get course ID and content ID from params
const { id, contentId } = Astro.params;
if (!id || !contentId) {
  return Astro.redirect('/404');
}

// Check authentication
const token = Astro.cookies.get('token');
const user = token ? verifyToken(token.value) : null;

// Fetch content details
const contentResult = await db.execute({
  sql: `SELECT 
          cc.title, 
          cc.description, 
          cc.type, 
          cc.content,
          c.instructor_id
        FROM course_content cc
        JOIN courses c ON cc.course_id = c.id
        WHERE cc.id = ? AND cc.course_id = ?`,
  args: [parseInt(contentId, 10), parseInt(id, 10)]
});

const content = contentResult.rows[0];
if (!content) {
  return Astro.redirect('/404');
}

// Check if user is the instructor and is a teacher
let isInstructor = false;
if (user) {
  const userResult = await db.execute({
    sql: 'SELECT role FROM users WHERE id = ?',
    args: [user.userId]
  });
  const userRole = userResult.rows[0]?.role;
  isInstructor = userRole === 'teacher' && user.userId === content.instructor_id;
}

// If instructor, fetch enrolled students and their attendance
let students: Student[] = [];
let attendance: Attendance[] = [];
if (isInstructor) {
  const studentsResult = await db.execute({
    sql: `
      SELECT u.id, u.first_name, u.last_name
      FROM enrollments e
      JOIN users u ON e.user_id = u.id
      WHERE e.course_id = ?
    `,
    args: [parseInt(id, 10)]
  });
  students = studentsResult.rows.map(row => ({
    id: Number(row.id),
    first_name: String(row.first_name),
    last_name: String(row.last_name)
  }));

  const attendanceResult = await db.execute({
    sql: `
      SELECT student_id, status
      FROM class_attendance
      WHERE session_id = ?
    `,
    args: [parseInt(contentId, 10)]
  });
  attendance = attendanceResult.rows.map(row => ({
    student_id: Number(row.student_id),
    status: String(row.status) as 'completed' | 'pending' | 'missed'
  }));
}
---

<Layout title={`${content.title} | Stembotics Academy`}>
  <div class="min-h-screen bg-slate-50 py-12">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold mb-4">{content.title}</h1>
        <p class="text-lg text-slate-700 mb-6">{content.description}</p>
        <div class="prose prose-lg mb-8">
          {content.content}
        </div>

        {isInstructor && (
          <div class="bg-white rounded-lg shadow-md p-6 mb-8">
            <h2 class="text-2xl font-bold mb-4">Attendance Management</h2>
            <div class="space-y-4">
              {students.map((student) => {
                const studentAttendance = attendance.find(a => a.student_id === student.id);
                return (
                  <div class="flex items-center justify-between p-4 bg-slate-50 rounded-lg">
                    <div>
                      <p class="font-medium">{student.first_name} {student.last_name}</p>
                    </div>
                    <div class="flex items-center gap-2">
                      <select
                        class="attendance-select rounded-md border-slate-300"
                        data-student-id={student.id}
                        data-class-id={contentId}
                      >
                        <option value="pending" selected={studentAttendance?.status === 'pending'}>Pending</option>
                        <option value="completed" selected={studentAttendance?.status === 'completed'}>Completed</option>
                        <option value="missed" selected={studentAttendance?.status === 'missed'}>Missed</option>
                      </select>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>

<script>
  // Handle attendance updates
  document.querySelectorAll('.attendance-select').forEach(select => {
    select.addEventListener('change', async (e) => {
      const target = e.target as HTMLSelectElement;
      const studentId = target.dataset.studentId;
      const classId = target.dataset.classId;
      const status = target.value;

      if (!studentId || !classId) return;

      try {
        const response = await fetch('/api/teachers/update-attendance', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            studentId: parseInt(studentId),
            classId: parseInt(classId),
            status
          }),
        });

        if (!response.ok) {
          throw new Error('Failed to update attendance');
        }

        // Show success message
        const successMessage = document.createElement('div');
        successMessage.className = 'fixed bottom-4 right-4 bg-green-500 text-white px-4 py-2 rounded-md';
        successMessage.textContent = 'Attendance updated successfully';
        document.body.appendChild(successMessage);
        setTimeout(() => successMessage.remove(), 3000);
      } catch (error) {
        console.error('Error updating attendance:', error);
        alert('Failed to update attendance. Please try again.');
      }
    });
  });
</script> 