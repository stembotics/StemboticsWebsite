---
interface Props {
  children: Array<{
    id: number;
    first_name: string;
    last_name: string;
    date_of_birth: string;
    grade_level: string;
    medical_emergency_contact_info: string | null;
    enrollments?: Array<{
      id: number;
      course: {
        id: number;
        title: string;
      };
      status: string;
    }>;
  }>;
}

const { children } = Astro.props;
---

<div class="bg-white rounded-xl shadow-md overflow-hidden">
  <div class="p-6">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-xl font-semibold">My Children</h2>
      <button
        id="addChildBtn"
        class="btn-primary"
      >
        Add Child
      </button>
    </div>

    {children.length === 0 ? (
      <div class="text-center py-8">
        <p class="text-slate-600">No children added yet. Add your first child to get started.</p>
      </div>
    ) : (
      <div class="grid gap-4">
        {children.map((child) => (
          <div class="border rounded-lg p-4 hover:border-primary-500 transition-colors">
            <div class="flex justify-between items-start">
              <div>
                <h3 class="font-medium text-lg">{child.first_name} {child.last_name}</h3>
                <p class="text-slate-600 text-sm mt-1">Grade {child.grade_level}</p>
                <p class="text-slate-600 text-sm">DOB: {new Date(child.date_of_birth).toLocaleDateString()}</p>
              </div>
              <div class="flex gap-2">
                <button
                  class="text-primary-600 hover:text-primary-700"
                  data-child-id={child.id}
                  data-action="edit"
                >
                  Edit
                </button>
                <button
                  class="text-red-600 hover:text-red-700"
                  data-child-id={child.id}
                  data-action="delete"
                >
                  Delete
                </button>
              </div>
            </div>
            {child.medical_emergency_contact_info && (
              <div class="mt-2 text-sm">
                <span class="font-medium">Medical Emergency Contact Info:</span> {child.medical_emergency_contact_info}
              </div>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</div>

<!-- Add/Edit Child Modal -->
<div id="childModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center">
  <div class="bg-white rounded-xl p-6 max-w-md w-full mx-4">
    <h3 class="text-xl font-semibold mb-4" id="modalTitle">Add Child</h3>
    <form id="childForm" class="space-y-4">
      <input type="hidden" id="childId" name="childId">
      
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="childFirstName" class="block text-sm font-medium text-slate-700 mb-1">First Name</label>
          <input 
            type="text" 
            id="childFirstName" 
            name="firstName" 
            required 
            class="w-full rounded-md border-slate-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
          >
        </div>
        <div>
          <label for="childLastName" class="block text-sm font-medium text-slate-700 mb-1">Last Name</label>
          <input 
            type="text" 
            id="childLastName" 
            name="lastName" 
            required 
            class="w-full rounded-md border-slate-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
          >
        </div>
      </div>

      <div>
        <label for="dateOfBirth" class="block text-sm font-medium text-slate-700 mb-1">Date of Birth</label>
        <input 
          type="date" 
          id="dateOfBirth" 
          name="dateOfBirth" 
          required 
          class="w-full rounded-md border-slate-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
        >
      </div>

      <div>
        <label for="grade" class="block text-sm font-medium text-slate-700 mb-1">Grade</label>
        <input 
          type="text" 
          id="grade" 
          name="grade" 
          required 
          class="w-full rounded-md border-slate-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
        >
      </div>

      <div>
        <label for="medicalInfo" class="block text-sm font-medium text-slate-700 mb-1">Medical Information (Optional)</label>
        <textarea 
          id="medicalInfo" 
          name="medicalInfo" 
          rows="2"
          class="w-full rounded-md border-slate-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
        ></textarea>
      </div>

      <div class="flex justify-end gap-3 mt-6">
        <button
          type="button"
          id="cancelBtn"
          class="px-4 py-2 text-slate-600 hover:text-slate-700"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="btn-primary"
        >
          Save
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const modal = document.getElementById('childModal') as HTMLDivElement;
  const modalTitle = document.getElementById('modalTitle') as HTMLHeadingElement;
  const childForm = document.getElementById('childForm') as HTMLFormElement;
  const addChildBtn = document.getElementById('addChildBtn') as HTMLButtonElement;
  const cancelBtn = document.getElementById('cancelBtn') as HTMLButtonElement;
  const childIdInput = document.getElementById('childId') as HTMLInputElement;

  // Show modal
  function showModal(title: string, childData?: any) {
    modalTitle.textContent = title;
    if (childData) {
      childIdInput.value = childData.id;
      (document.getElementById('childFirstName') as HTMLInputElement).value = childData.firstName;
      (document.getElementById('childLastName') as HTMLInputElement).value = childData.lastName;
      (document.getElementById('dateOfBirth') as HTMLInputElement).value = childData.dateOfBirth;
      (document.getElementById('grade') as HTMLInputElement).value = childData.grade;
      (document.getElementById('medicalInfo') as HTMLTextAreaElement).value = childData.medicalInfo || '';
    } else {
      childForm.reset();
      childIdInput.value = '';
    }
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  // Hide modal
  function hideModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  // Event listeners
  addChildBtn.addEventListener('click', () => showModal('Add Child'));
  cancelBtn.addEventListener('click', hideModal);

  // Handle edit and delete buttons
  document.querySelectorAll('[data-action]').forEach(button => {
    button.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const action = target.dataset.action;
      const childId = target.dataset.childId;

      if (action === 'edit') {
        // Fetch child data and show edit modal
        try {
          const response = await fetch(`/api/children/${childId}`);
          const childData = await response.json();
          showModal('Edit Child', childData);
        } catch (error) {
          console.error('Error fetching child data:', error);
        }
      } else if (action === 'delete') {
        if (confirm('Are you sure you want to delete this child?')) {
          try {
            const response = await fetch(`/api/children/${childId}`, {
              method: 'DELETE'
            });
            if (response.ok) {
              window.location.reload();
            }
          } catch (error) {
            console.error('Error deleting child:', error);
          }
        }
      }
    });
  });

  // Handle form submission
  childForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(childForm);
    const data = Object.fromEntries(formData.entries());
    const childId = childIdInput.value;

    try {
      const response = await fetch(
        childId ? `/api/children/${childId}` : '/api/children',
        {
          method: childId ? 'PUT' : 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        }
      );

      if (response.ok) {
        window.location.reload();
      } else {
        const error = await response.json();
        alert(error.message || 'An error occurred');
      }
    } catch (error) {
      console.error('Error saving child:', error);
      alert('An error occurred while saving');
    }
  });
</script> 