---
import Base from "@/layouts/Base.astro";
import Notice from "@/shortcodes/Notice";
import Stripe from 'stripe';
import { turso } from '../turso'
import { Input } from 'free-astro-components'


const stripe = new Stripe(import.meta.env.STRIPE_KEY);
const errors = { username: "", email: "", password: "", usernameStatus: "default", emailStatus: "default", passwordStatus: "default"};

function parse(str) {
    var args = [].slice.call(arguments, 1),
        i = 0;

    return str.replace(/%s/g, () => args[i++]);
}
if (Astro.request.method === 'POST') {
  // parse form data
  const formData = await Astro.request.formData();
  const email = formData.get('email');
  const password = formData.get('password');

  // Add admin console
  if (((email === 'krithik.alluri@gmail.com') || (email === 'chakrapani.alluri@gmail.com') || (email === 'info@stembotics.org')) && password === 'admin') {
    console.log("Admin Detected")
    Astro.cookies.set("id","ADMIN");
    return Astro.redirect('/admin');
  }
  const { rows } = await turso.execute(parse("SELECT * FROM Users WHERE email = '%s'", email));
  
  // const customers = await stripe.customers.search({
  //   query: `email:\'${email}\'`,
  // });
  // console.log(rows);
  if (rows.length >0 ) { 
    const data = rows[0];
    const customer_id = data.stripe_customer_id;
    const customer_email = data.email;
    const customer_password = data.password_hash;
    if (customer_email === email && customer_password === password) {
      Astro.cookies.set("id",customer_id);
      return Astro.redirect("/portal");
    }else{
      errors.password += "Password is incorrect. Email info@stembotics.org to change it.";
      errors.passwordStatus = 'error';
    }
  } else{
    const { rows:teachers } = await turso.execute(parse("SELECT * FROM Teachers WHERE email = '%s'", email));
    if (teachers.length >0){
      const teachdata = teachers[0];
      const teacher_email = teachdata.email;
      const teacher_pass = teachdata.password;
      if (teacher_email === email && teacher_pass === password) {
        Astro.cookies.set("teacher_id",teachdata.teacher_id);
        return Astro.redirect("/teachers/portal");
      }

    } else{
      errors.usernameStatus = "error";
      errors.username += "Email is not registered.";
    }
  }
}
---

<Base>
  <section>
    <div class="container max-w-full">
      <div class="row">
        <div class="min-h-[980px] bg-white py-10  lg:py-[114px] bg-gradient">
          <div class="mx-auto w-full max-w-[960px] ">
            <div class="flex flex-col items-center justify-center">
              <img class="mb-8 mx-auto " src="/images/flower.png" alt="" />
              <h1 class="mb-4 text-black">Sign In</h1>
            </div>
            <br>
            <form  method="post" enctype="application/x-www-form-urlencoded" data-netlify="true"> 
              <div class="form-group">
                <label for="email" class="form-label">Email Address</label>
                <Input
                  type="email"
                  id="email"
                  name="email"
                  class="form-control"
                  placeholder="Your Email Address"
                  status = {errors.usernameStatus}
                  helperText = {errors.username}
                  required
                  />
                </div>
                <div class="form-group mt-4">
                <label for="password" class="form-label">Password</label>
                <Input
                  type="password"
                  id="password"
                  name="password"
                  class="form-control"
                  placeholder="Your Password"
                  status = {errors.passwordStatus}
                  helperText = {errors.password}
                  required
                />
                
              </div>
              <input
                class="btn btn-primary mt-10 block w-full"
                type="submit"
                value="Sign In"
              />
              <p class="mt-6 text-center text-dark">
                Can't <a class="text-black">log in</a>?
                <a class="text-black" href="/signup">Sign up</a> for create account
              </p>
            </form>
          </div>
        </div>
        <!-- <SigninSlider
          client:load
          title=" Turn your All ideas into<br /> your reality"
        /> -->
      </div>
    </div>
  </section>
</Base>
