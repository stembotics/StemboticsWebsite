---
import Base from "@/layouts/Base.astro";
import { createRequire } from 'module';
import SigninSlider from "@/layouts/function-components/SigninSlider.jsx";
import { Phone } from "react-feather";
import Notice from "@/layouts/shortcodes/Notice.jsx"
import Stripe from 'stripe';
import { Input } from 'free-astro-components'
import { turso } from '../turso'

function parse(str) {
    var args = [].slice.call(arguments, 1),
        i = 0;

    return str.replace(/%s/g, () => args[i++]);
}

const require = createRequire(import.meta.url);
const stripe = new Stripe(import.meta.env.STRIPE_KEY);
const errors = { username: "", email: "", password: "", usernameStatus: "default", emailStatus: "default", passwordStatus: "default"};


if (Astro.request.method === 'POST') {
  // parse form data
  const formData = await Astro.request.formData();
  const name = formData.get('name'); // get the name field
  const tel = formData.get('tel');
  const email = formData.get('email');
  const password = formData.get('password');

  if (typeof name !== "string" || name.length < 1) {
    errors.username += "Please enter a Name.";
    errors.usernameStatus = "error";
  }
  if (typeof password !== "string" || password.length < 6) {
    errors.password += "Password must be at least 6 characters. ";
    errors.passwordStatus = "error";
  }
  // const emailCount=1;
  const { rows } = await turso.execute(parse("SELECT COUNT(*) AS count FROM Users WHERE email = '%s'", email));
  const emailCount = rows[0].count; // Safely access count with optional chaining
  console.log(emailCount);
  const customers = await stripe.customers.search({
    query: `email:\'${email}\'`,
  });
  if (emailCount ==0 ) { 
    console.log("check1");
    const customer = await stripe.customers.create({
      name: name,
      email: email,
      phone: tel
    });
    // console.log(customer['id'])

    const { rows: parentResult } = await turso.execute({
      sql: 'INSERT INTO Users (customer_name, email, phone_number, password_hash, stripe_customer_id) VALUES (?, ?, ?, ?, ?) RETURNING user_id',
      args: [`${name}`, `${email}`, `+1${tel}`, `${password}`, `${customer['id']}`], // Wrapped in quotes
    });

    const parentId = parentResult[0].user_id; // Safely access count with optional chaining
    // console.log(parentId)
    await stripe.customers.update(customer['id'], {
      metadata: {
        ...customer.metadata, // Keep existing metadata
        UserID: parentId.toString(), // Update or add ParentID
      },
    });
    Astro.cookies.set("id",customer['id'])
    return Astro.redirect("/portal")
  } else{
    errors.email += "Email is already registered.";
    errors.emailStatus = "error"
  }
}

---

<Base>
  <section>
    <div class="container max-w-full">
      <div class="row">
        <div class="min-h-[980px] bg-white py-10  lg:py-[114px] bg-gradient">
          <div class="mx-auto w-full max-w-[960px] ">
            <div class="flex flex-col items-center justify-center">
              <img class="mb-8 mx-auto " src="/images/flower.png" alt="" />
              <h1 class="mb-4 text-black">Sign Up</h1>
              <h4>Get ready to be immersed in learning</h4>
            </div>
            <!-- <div class="signin-options mt-10">
              <a class="btn btn-outline-white block w-full text-dark" href="#"
                >Sign Up With Google</a
              >
            </div>
            <div
              class="relative my-8 text-center after:absolute after:left-0 after:top-1/2 after:z-[0] after:w-full after:border-b after:border-border after:content-['']"
            >
              <span class="relative z-[1] inline-block bg-white px-2"
                >Or Sign Up With Email</span
              >
            </div> -->

            <form method="POST" enctype="application/x-www-form-urlencoded" data-netlify="true">
              <br>
              <div class="form-group">
                <label for="name" class="form-label text-black">Full Name</label>
                <Input
                  type="text"
                  id="name"
                  name="name"
                  class="form-control"
                  placeholder="Your Full Name"
                  status = {errors.usernameStatus}
                  helperText = {errors.username}
                  required
                />
              </div>

              <div class="form-group mt-4">
                <label for="email" class="form-label text-black">Email Address</label>
                <Input
                  type="email"
                  id="email"
                  name="email"
                  class="form-control"
                  placeholder="Your Email Address"
                  status = {errors.emailStatus}
                  helperText = {errors.email}
                  required
                />
              </div>
              <div class="form-group mt-4">
                <label for="tel" class="form-label text-black">Phone No.</label>
                <Input
                  type="tel"
                  id="tel"
                  name="tel"
                  class="form-control"
                  placeholder="Your Phone Number"
                  required
                />
              </div>
              <div class="form-group mt-4">
                <label for="password" class="form-label text-black">Password</label>
                <Input
                  type="password"
                  minlength="6"
                  id="password"
                  name="password"
                  class="form-control"
                  placeholder="Your Password"
                  status = {errors.passwordStatus}
                  helperText = {errors.password}
                  required
                />

              </div>
              <input
                class="btn btn-primary mt-10 block w-full"
                type="submit"
                value="Sign Up"
              />
            </form>
            
            <p class="mt-6 text-center text-dark">
              Have an <a class="text-black">account</a>?
              <a class="text-black" href="/signin">Sign in</a> here
            </p>
          </div>
        </div>
        <!-- <SigninSlider
        client:load
        title="Get ready to learn!"
        /> -->
      </div>
    </div>
  </section>
</Base>
